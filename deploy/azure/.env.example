# Copied to .env by setup.sh. Never commit the real .env.
# Mainnet app (the one players find in the Pi Browser)
DOMAIN=sisyphusball.app
CONTACT_EMAIL=hajinchoi139@gmail.com
PI_VALIDATION_KEY=
# Server API key of the Mainnet app (Carve the Mountain). Empty = payments off.
PI_API_KEY=
# Testnet app: its own domain, key and ranking (optional)
TESTNET_DOMAIN=sisyphusball-testnet.eastasia.cloudapp.azure.com
TESTNET_PI_VALIDATION_KEY=
TESTNET_PI_API_KEY=
# Optional Flutter renderer override, e.g. {"renderer":"canvaskit","canvasKitForceCpuOnly":true}
FLUTTER_ENGINE=
# Debugging only: lets the app upload a screenshot of its own rendering,
# viewable at https://<domain>/api/debug/shot.png. Leave off normally.
DEBUG_SHOTS=
